{
    "name": "linku/api-documentation-bundle",
    "description": "Extension to API-Platform to modify the documenation with more ease",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "Symfony",
        "bundle",
        "API Platform",
        "API Documentation",
        "OpenAPI"
    ],
    "require": {
        "php": "^8.4",
        "api-platform/metadata": "^4.3",
        "api-platform/openapi": "^4.3",
        "symfony/config": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/http-foundation": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0",
        "symfony/routing": "^7.4|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Linku\\ApiDocumentationBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Linku\\ApiDocumentationBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    }
}
